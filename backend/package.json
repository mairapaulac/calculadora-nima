{
  "name": "calculadora-nima-backend",
  "version": "1.0.0",
  "description": "API para calculo de orcamento de demandas de manufatura aditiva (Laboratorio NIMA)",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
