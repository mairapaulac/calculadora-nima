PORT=3333
CORS_ORIGIN=http://localhost:5173
# Connection string do Postgres (ex: Neon - https://neon.tech). Formato:
# postgresql://usuario:senha@host/banco?sslmode=require
DATABASE_URL=

# Integracao com o Notion (envio do orcamento para a base do laboratorio).
# Token de uma integracao interna criada em https://www.notion.so/my-integrations
# A base precisa estar compartilhada com essa integracao (pagina da base -> Conexoes).
NOTION_TOKEN=
# Id do data source ("planilha") onde cada orcamento vira uma linha.
NOTION_DATA_SOURCE_ID=2621055c-65f1-83f2-9645-0792b133ac44
